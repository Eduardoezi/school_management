# ============================================================
# ENTORNO
# ============================================================
# 'production' en el servidor real, 'development' en tu PC.
FLASK_ENV=production
FLASK_DEBUG=false

# ============================================================
# SEGURIDAD
# ============================================================
# Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave Fernet para cifrar cuentas bancarias.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ENCRYPTION_KEY=

# ============================================================
# SERVIDOR
# ============================================================
# Con reverse proxy (Apache/Nginx):
HOST=127.0.0.1
PORT=8000
BEHIND_PROXY=true

# Sin reverse proxy (Waitress directo, solo desarrollo):
# HOST=0.0.0.0
# PORT=5000
# BEHIND_PROXY=false

# URL pública / host visibles SOLO para logs de arranque.
# Opcional; no afecta el comportamiento de la app.
# PUBLIC_URL=https://midominio.example.org
# PUBLIC_HOST=midominio.example.org

# Nombre mDNS que anuncia run.py en desarrollo.
# PUBLIC_MDNS_NAME=sistema-escolar.local

# ============================================================
# SSL (opcional; solo para run.py en desarrollo con HTTPS local)
# Rutas relativas a la raíz del proyecto o absolutas del sistema.
# NUNCA subas certificados reales al repositorio.
# ============================================================
# SSL_CERT=./certs/dev/cert.pem
# SSL_KEY=./certs/dev/key.pem

# ============================================================
# BASE DE DATOS MySQL
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=school_db

# ============================================================
# COOKIES / SESIÓN
# ============================================================
# true si sirves por HTTPS.
SESSION_COOKIE_SECURE=true

# ============================================================
# WEB AUTHN
# ============================================================
# WEBAUTHN_RP_ID: dominio EXACTO que el navegador ve.
#   - Sin esquema, sin puerto, sin path.
#   - Debe coincidir con el Host que recibe el servidor.
# WEBAUTHN_ORIGIN: esquema + dominio + puerto (si aplica).
#   - Debe empezar con https:// en producción.
# Cambiá estos valores por los TUYOS reales.
# ============================================================
WEBAUTHN_RP_ID=midominio.example.org
WEBAUTHN_RP_NAME=Sistema Escolar
WEBAUTHN_ORIGIN=https://midominio.example.org

# ============================================================
# WAITRESS
# ============================================================
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=200
WAITRESS_CHANNEL_TIMEOUT=120

# ============================================================
# LOGS
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# BACKUPS
# ============================================================
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ============================================================
# DOCKER (solo si usas docker-compose)
# ============================================================
MYSQL_ROOT_PASSWORD=