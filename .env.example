# ============================================================
# ENTORNO
# ============================================================
# 'production' en el servidor real, 'development' en tu PC.
FLASK_ENV=production
FLASK_DEBUG=false

# ============================================================
# SEGURIDAD
# ============================================================
# Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave Fernet para cifrar cuentas bancarias.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ENCRYPTION_KEY=

# ============================================================
# SERVIDOR
# ============================================================
# Con reverse proxy (Apache/Nginx):
HOST=127.0.0.1
PORT=8000
BEHIND_PROXY=true

# Sin reverse proxy (Waitress directo, solo desarrollo):
# HOST=0.0.0.0
# PORT=5000
# BEHIND_PROXY=false

# ============================================================
# SSL (opcional; solo para run.py en desarrollo con HTTPS local)
# ============================================================
# SSL_CERT=C:\certs\gestionescolar.duckdns.org\gestionescolar.duckdns.org-chain.pem
# SSL_KEY=C:\certs\gestionescolar.duckdns.org\gestionescolar.duckdns.org-key.pem

# ============================================================
# BASE DE DATOS MySQL
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=school_db

# ============================================================
# COOKIES / SESIÓN
# ============================================================
# true si sirves por HTTPS.
SESSION_COOKIE_SECURE=true

# ============================================================
# WEB AUTHN
# ============================================================
# Debe coincidir EXACTAMENTE con el dominio que el navegador ve.
WEBAUTHN_RP_ID=gestionescolar.duckdns.org
WEBAUTHN_RP_NAME=Sistema Escolar IEE Villa de Cura
WEBAUTHN_ORIGIN=https://gestionescolar.duckdns.org:5000

# ============================================================
# WAITRESS
# ============================================================
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=200
WAITRESS_CHANNEL_TIMEOUT=120

# ============================================================
# LOGS
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# BACKUPS
# ============================================================
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ============================================================
# DOCKER (solo si usas docker-compose)
# ============================================================
MYSQL_ROOT_PASSWORD=